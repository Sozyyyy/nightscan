# Generate a strong random value; never commit the real .env file.
NIGHTSCAN_SECRET_KEY=replace-this-with-a-long-random-secret

# Required in Vercel for persistent accounts, rate limits and the shared API Library.
# Use a PostgreSQL connection string from Neon, Supabase or another managed PostgreSQL host.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: improves public web search quality. Without it, NIGHTSCAN uses a DuckDuckGo HTML search fallback.
TAVILY_API_KEY=

# Optional: enable Google sign-in/up. Add the exact callback URL to Google OAuth's authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-PROJECT.vercel.app/auth/google/callback
